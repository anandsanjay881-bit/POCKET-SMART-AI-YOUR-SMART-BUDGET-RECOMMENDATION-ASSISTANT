## 4. Automated Unit Test Code Example (`test_recommendations.py`)

```python
import pytest
from datetime import date
from main import analyze_spending_and_recommend, Transaction

def test_spending_within_budget():
    transactions = [
        Transaction(transaction_id="t1", amount=100.0, category="Groceries", vendor="Supermarket", date=date(2026, 9, 1))
    ]
    response = analyze_spending_and_recommend(income=3000.0, goal=500.0, transactions=transactions)
    
    assert response.total_spent == 100.0
    assert response.remaining_budget == 2400.0
    assert "✅ Great job!" in response.insights[0]

def test_spending_exceeding_budget():
    transactions = [
        Transaction(transaction_id="t1", amount=2600.0, category="Shopping", vendor="Mall", date=date(2026, 9, 1))
    ]
    response = analyze_spending_and_recommend(income=3000.0, goal=500.0, transactions=transactions)
    
    assert response.total_spent == 2600.0
    assert response.remaining_budget == -100.0
    assert "⚠️ Warning:" in response.insights[0]
